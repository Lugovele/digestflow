POSTFLOW_RESEARCH_PROVIDER=openai
POSTFLOW_RESEARCH_MODEL=gpt-4o-mini-2024-07-18

POSTFLOW_CANDIDATE_WRITER_PROVIDER=anthropic
POSTFLOW_CANDIDATE_WRITER_MODEL=claude-sonnet-5

