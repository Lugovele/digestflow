DJANGO_SECRET_KEY=unsafe-dev-placeholder-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

OPENAI_API_KEY=
GEMINI_API_KEY=
